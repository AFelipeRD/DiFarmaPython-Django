# ============================================================
# DiFarma — plantilla de variables de entorno
# Copia este archivo como .env y exporta las variables antes de
# ejecutar el proyecto. NUNCA subas tu .env real al repositorio.
# ============================================================

# Clave secreta de Django (genérala con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada

# Solo True en desarrollo local. En producción SIEMPRE False.
DJANGO_DEBUG=True

# Hosts permitidos, separados por coma (producción: tu dominio real).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
